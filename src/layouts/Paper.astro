---
import Base from './Base.astro';

interface Props {
  title: string;
  subtitle?: string;
  date: Date;
  abstract?: string;
  substack?: string;
}
const { title, subtitle, date, abstract, substack } = Astro.props;
const fmt = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title={title} description={abstract ?? subtitle}>
  <article class="paper">
    <header class="paper-head">
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      <div class="meta">
        <span>Connor Davis</span>
        <time datetime={date.toISOString()}>{fmt}</time>
        {substack && <a href={substack}>Discuss on Substack ↗</a>}
      </div>
      {abstract && <p class="abstract">{abstract}</p>}
    </header>
    <slot />
  </article>
</Base>
